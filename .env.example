APP_NAME=70LatRussellHobbs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_CONTACT_MAIL="contact@example.com"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DOCKER_DOMAIN=${APP_NAME}
DOCKER_AUTHOR=developer
DOCKER_HTTPD_PORT=8100
DOCKER_MYSQL_PORT=8101
DOCKER_PHPMYADMIN_PORT=8102
DOCKER_PGADMIN_PORT=8103
DOCKER_REDIS_PORT=8104
DOCKER_REDISINSIGHT_PORT=8105
DOCKER_VITE_PORT=8106
DOCKER_MAILCATCHER_SMTP=8107
DOCKER_MAILCATCHER_WEB=8108

DB_CONNECTION=mysql
DB_HOST=${DOCKER_DOMAIN}-mysql
DB_PORT=3306
DB_DATABASE=rh_70lat
DB_USERNAME=rh_70lat
DB_PASSWORD=rh_70lat
DB_ROOTPASSWORD=root_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=${DOCKER_DOMAIN}-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=${DOCKER_DOMAIN}-mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
